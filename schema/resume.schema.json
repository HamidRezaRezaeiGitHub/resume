{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": { "type": "string", "const": "../../schema/resume.schema.json" },
    "navigation": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "sectionId": {
            "type": "string",
            "enum": ["experience", "projects", "skills", "education", "contact"]
          }
        },
        "required": ["label", "sectionId"],
        "additionalProperties": false
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "monogram": {
          "type": "string",
          "minLength": 1,
          "description": "Short navigation brand, without the decorative period. Example: hr"
        },
        "headline": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "links": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" }
            },
            "required": ["label", "url"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "monogram",
        "headline",
        "summary",
        "location",
        "email",
        "links"
      ],
      "additionalProperties": false,
      "description": "Personal identity, headline, summary, contact details and profile links. Also supplies HTML metadata and the no-JavaScript contact fallback."
    },
    "hero": {
      "type": "object",
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "experienceLabel": { "type": "string", "minLength": 1 }
      },
      "required": ["eyebrow", "experienceLabel"],
      "additionalProperties": false
    },
    "downloads": {
      "type": "object",
      "properties": {
        "buttonLabel": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "closeLabel": { "type": "string", "minLength": 1 },
        "options": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "enum": ["compact", "long"] },
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\/resumes\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.pdf$"
              }
            },
            "required": ["id", "label", "description", "path"],
            "additionalProperties": false
          }
        }
      },
      "required": ["buttonLabel", "title", "closeLabel", "options"],
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "properties": {
        "experience": {
          "type": "object",
          "properties": { "title": { "type": "string", "minLength": 1 } },
          "required": ["title"],
          "additionalProperties": false
        },
        "projects": {
          "type": "object",
          "properties": { "title": { "type": "string", "minLength": 1 } },
          "required": ["title"],
          "additionalProperties": false
        },
        "skills": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "eyebrow": { "type": "string", "minLength": 1 }
          },
          "required": ["title", "eyebrow"],
          "additionalProperties": false
        },
        "education": {
          "type": "object",
          "properties": { "title": { "type": "string", "minLength": 1 } },
          "required": ["title"],
          "additionalProperties": false
        },
        "contact": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "eyebrow": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "emailLabel": { "type": "string", "minLength": 1 }
          },
          "required": ["title", "eyebrow", "description", "emailLabel"],
          "additionalProperties": false
        }
      },
      "required": ["experience", "projects", "skills", "education", "contact"],
      "additionalProperties": false
    },
    "experiences": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Stable lowercase ID, such as my-new-role. Keep it when editing copy so links continue to work."
          },
          "title": { "type": "string", "minLength": 1 },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
            "description": "Use YYYY-MM when the month is known, otherwise YYYY. Do not invent date precision."
          },
          "endDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                "description": "Use YYYY-MM when the month is known, otherwise YYYY. Do not invent date precision."
              },
              { "type": "string", "const": "present" }
            ]
          },
          "bullets": {
            "description": "Optional details. A nonempty list makes the entry expandable, initially collapsed. Omit or leave empty for a simple entry.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                  "description": "Stable lowercase ID, such as my-new-role. Keep it when editing copy so links continue to work."
                },
                "text": { "type": "string", "minLength": 1 }
              },
              "required": ["id", "text"],
              "additionalProperties": false
            }
          },
          "organization": { "type": "string", "minLength": 1 },
          "team": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 }
        },
        "required": [
          "id",
          "title",
          "startDate",
          "endDate",
          "organization",
          "location"
        ],
        "additionalProperties": false
      },
      "description": "Professional roles in display order, newest first. Copy an entry and give it and its bullets unique IDs; no React changes needed."
    },
    "projects": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Stable lowercase ID, such as my-new-role. Keep it when editing copy so links continue to work."
          },
          "title": { "type": "string", "minLength": 1 },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
            "description": "Use YYYY-MM when the month is known, otherwise YYYY. Do not invent date precision."
          },
          "endDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                "description": "Use YYYY-MM when the month is known, otherwise YYYY. Do not invent date precision."
              },
              { "type": "string", "const": "present" }
            ]
          },
          "bullets": {
            "description": "Optional details. A nonempty list makes the entry expandable, initially collapsed. Omit or leave empty for a simple entry.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                  "description": "Stable lowercase ID, such as my-new-role. Keep it when editing copy so links continue to work."
                },
                "text": { "type": "string", "minLength": 1 }
              },
              "required": ["id", "text"],
              "additionalProperties": false
            }
          },
          "role": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "links": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri" }
              },
              "required": ["label", "url"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "title", "startDate", "endDate", "role", "stage"],
        "additionalProperties": false
      },
      "description": "Personal projects in display order. Stage describes maturity; links are optional."
    },
    "skillGroups": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Stable lowercase ID, such as my-new-role. Keep it when editing copy so links continue to work."
          },
          "title": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "title"],
        "additionalProperties": false
      },
      "description": "Headings in the Skills list and printed resume."
    },
    "skillCategories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Stable lowercase ID, such as my-new-role. Keep it when editing copy so links continue to work."
          },
          "title": { "type": "string", "minLength": 1 },
          "groupId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Stable lowercase ID, such as my-new-role. Keep it when editing copy so links continue to work."
          }
        },
        "required": ["id", "title", "groupId"],
        "additionalProperties": false
      },
      "description": "Graph topic nodes. Each groupId references a skillGroups ID; several topics may share a printed group."
    },
    "skillRelationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Stable lowercase ID, such as my-new-role. Keep it when editing copy so links continue to work."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Stable lowercase ID, such as my-new-role. Keep it when editing copy so links continue to work."
          }
        },
        "required": ["source", "target"],
        "additionalProperties": false
      },
      "description": "Additional undirected edges between existing skill or topic IDs. Do not repeat category membership, reverse pairs or self-links."
    },
    "skills": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Stable lowercase ID, such as my-new-role. Keep it when editing copy so links continue to work."
          },
          "label": { "type": "string", "minLength": 1 },
          "categories": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["id", "label", "categories"],
        "additionalProperties": false
      },
      "description": "One entry per keyword. categories references skillCategories IDs and automatically creates those connections. Relationships and degree determine layout and size."
    },
    "education": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Stable lowercase ID, such as my-new-role. Keep it when editing copy so links continue to work."
          },
          "title": { "type": "string", "minLength": 1 },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
            "description": "Use YYYY-MM when the month is known, otherwise YYYY. Do not invent date precision."
          },
          "endDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                "description": "Use YYYY-MM when the month is known, otherwise YYYY. Do not invent date precision."
              },
              { "type": "string", "const": "present" }
            ]
          },
          "bullets": {
            "description": "Optional details. A nonempty list makes the entry expandable, initially collapsed. Omit or leave empty for a simple entry.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                  "description": "Stable lowercase ID, such as my-new-role. Keep it when editing copy so links continue to work."
                },
                "text": { "type": "string", "minLength": 1 }
              },
              "required": ["id", "text"],
              "additionalProperties": false
            }
          },
          "field": { "type": "string", "minLength": 1 },
          "organization": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 }
        },
        "required": [
          "id",
          "title",
          "startDate",
          "endDate",
          "field",
          "organization",
          "location"
        ],
        "additionalProperties": false
      },
      "description": "Degrees in display order. Dates follow the same rules as professional roles."
    }
  },
  "required": [
    "navigation",
    "profile",
    "hero",
    "downloads",
    "sections",
    "experiences",
    "projects",
    "skillGroups",
    "skillCategories",
    "skillRelationships",
    "skills",
    "education"
  ],
  "additionalProperties": false,
  "title": "Resume content",
  "description": "Generated from src/data/resume.schema.ts. Editor hints cover structure; npm run validate:content also checks dates, IDs, relationships and PDF assets."
}
